generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  password_hash   String
  avatar          String?
  primary_color   String?        @default("#3b82f6") // Default blue
  secondary_color String?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  couple_as_user1 Couple?        @relation("User1")
  couple_as_user2 Couple?        @relation("User2")
  transactions    Transaction[]
}

model Couple {
  id          String   @id @default(uuid())
  name        String?
  user_1_id   String   @unique
  user_2_id   String?  @unique
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user_1      User     @relation("User1", fields: [user_1_id], references: [id])
  user_2      User?    @relation("User2", fields: [user_2_id], references: [id])

  goals       Goal[]
  invites     CoupleInvite[]
}

model Goal {
  id            String   @id @default(uuid())
  couple_id     String
  name          String
  description   String?
  target_amount Float
  deadline      DateTime?
  icon          String?
  color         String?
  status        String   @default("ACTIVE") // ACTIVE, COMPLETED, ARCHIVED
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  couple        Couple   @relation(fields: [couple_id], references: [id], onDelete: Cascade)
  boxes         SavingsBox[]
  transactions  Transaction[]
}

model SavingsBox {
  id            String   @id @default(uuid())
  goal_id       String
  name          String
  description   String?
  target_amount Float
  icon          String?
  color         String?
  owner_type    String   @default("SHARED") // SHARED, INDIVIDUAL_USER_1, INDIVIDUAL_USER_2
  is_archived   Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  goal          Goal     @relation(fields: [goal_id], references: [id], onDelete: Cascade)
  transactions  Transaction[]
}

model Transaction {
  id               String   @id @default(uuid())
  box_id           String?
  goal_id          String?
  user_id          String
  type             String   @default("DEPOSIT") // DEPOSIT, WITHDRAWAL
  amount           Float
  description      String?
  transaction_date DateTime @default(now())
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  box              SavingsBox? @relation(fields: [box_id], references: [id], onDelete: Cascade)
  goal             Goal?       @relation(fields: [goal_id], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model CoupleInvite {
  id            String   @id @default(uuid())
  couple_id     String
  invited_email String?
  token         String   @unique
  status        String   @default("PENDING") // PENDING, ACCEPTED, EXPIRED
  expires_at    DateTime
  created_at    DateTime @default(now())

  couple        Couple   @relation(fields: [couple_id], references: [id])
}
